60.07)\nexper        |   11.99 (   3.26,   20.73) |   0.17 ( -0.11,  0.45) |   11.32 (    2.64,   19.99)\ntenure       |    4.07 (  -1.67,    9.80) |   0.12 ( -0.06,  0.30) |    3.59 (   -2.11,    9.29)\nage          |    9.95 (  -0.79,   20.69) |  -0.37 ( -0.72, -0.03) |   11.44 (    0.75,   22.14)\nparedu       |   10.90 (   5.21,   16.59) |   0.32 (  0.14,  0.51) |    9.60 (    3.90,   15.30)\nblack        | -105.81 (-203.72,   -7.90) | -12.76 (-15.86, -9.65) |  -54.91 ( -156.43,   46.61)\nmarried      |  171.79 (  85.28,  258.29) |   0.94 ( -1.80,  3.69) |  168.02 (   82.12,  253.92)\nIQ           |                            |                        |    3.99 (    1.69,    6.29)\n------------------------------------------------------------------------------------------------\nObservations |                        722 |                    722 |                         722\n```\n\n\n:::\n\n```{.r .cell-code  code-fold=\"true\"}\n## Compare goodness of fit measures using `performance::compare_performance`\nlibrary(performance)\ncompare_performance(fit_s, fit_aux, fit_l)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n# Comparison of Model Performance Indices\n\nName    | Model |   AIC (weights) |  AICc (weights) |   BIC (weights) |    R2\n-----------------------------------------------------------------------------\nfit_s   |    lm | 10595.5 (<.001) | 10595.7 (<.001) | 10636.7 (<.001) | 0.189\nfit_aux |    lm |  5612.6 (>.999) |  5612.9 (>.999) |  5653.9 (>.999) | 0.377\nfit_l   |    lm | 10585.8 (<.001) | 10586.1 (<.001) | 10631.7 (<.001) | 0.202\n\nName    | R2 (adj.) |    RMSE |   Sigma\n---------------------------------------\nfit_s   |     0.181 | 367.307 | 369.359\nfit_aux |     0.371 |  11.652 |  11.717\nfit_l   |     0.193 | 364.352 | 366.645\n```\n\n\n:::\n\n```{.r .cell-code  code-fold=\"true\"}\n## 1.8.2 Compare all models together with `modelsummary::modelsummary`\nall_mods <- list(\n  `Short (dep: wage)` = fit_s, \n  `Auxilary (dep: IQ)` = fit_aux, \n  `Long (dep: wage)` = fit_l\n  )\n\n# Display the list structure:\nstr(all_mods, max.level = 1)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\nList of 3\n $ Short (dep: wage) :List of 13\n  ..- attr(*, \"class\")= chr \"lm\"\n $ Auxilary (dep: IQ):List of 13\n  ..- attr(*, \"class\")= chr \"lm\"\n $ Long (dep: wage)  :List of 13\n  ..- attr(*, \"class\")= chr \"lm\"\n```\n\n\n:::\n\n```{.r .cell-code  code-fold=\"true\"}\n# Summarise the models\nlibrary(modelsummary)\nmodelsummary(all_mods)\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<!-- preamble start -->\n\n    <script>\n\n      function styleCell_ayb4p0mq6z4tm3mthkrq(i, j, css_id) {\n          var table = document.getElementById(\"tinytable_ayb4p0mq6z4tm3mthkrq\");\n          var cell = table.querySelector(`[data-row=\"${i}\"][data-col=\"${j}\"]`);\n          if (cell) {\n              console.log(`Styling cell at (${i}, ${j}) with class ${css_id}`);\n              cell.classList.add(css_id);\n          } else {\n              console.warn(`Cell at (${i}, ${j}) not found.`);\n          }\n      }\n      function spanCell_ayb4p0mq6z4tm3mthkrq(i, j, rowspan, colspan) {\n        var table = document.getElementById(\"tinytable_ayb4p0mq6z4tm3mthkrq\");\n        const targetCell = table.querySelector(`[data-row=\"${i}\"][data-col=\"${j}\"]`);\n        if (!targetCell) {\n          console.warn(`Cell at (${i}, ${j}) not found.`);\n        }\n\n        // Get all cells that need to be removed\n        const cellsToRemove = [];\n        for (let r = 0; r < rowspan; r++) {\n          for (let c = 0; c < colspan; c++) {\n            if (r === 0 && c === 0) continue; // Skip the target cell\n            const cell = table.querySelector(`[data-row=\"${i + r}\"][data-col=\"${j + c}\"]`);\n            if (cell) {\n              cellsToRemove.push(cell);\n            }\n          }\n        }\n\n        // Remove all cells\n        cellsToRemove.forEach(cell => cell.remove());\n\n        // Set rowspan and